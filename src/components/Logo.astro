---
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<span class="logo" style={`--s:${size}px`} aria-label="Simply N Sorted">
  <span aria-hidden="true">simply<span class="n">n</span>sorted<span class="dot"></span></span>
</span>

<style>
  .logo {
    font-weight: 800;
    font-size: var(--s);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
    white-space: nowrap;
  }
  .n {
    color: var(--accent);
  }
  .dot {
    display: inline-block;
    width: calc(var(--s) * 0.22);
    height: calc(var(--s) * 0.22);
    margin-left: calc(var(--s) * 0.06);
    border-radius: 999px;
    background: var(--accent);
  }
</style>
