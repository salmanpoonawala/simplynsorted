---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
---

<article class="card" data-category={p.category}>
  <a href={`/work/${project.id}/`} class="cover" style={`--tint:${p.tint}`} aria-label={`${p.title} case study`}>
    {
      p.video ? (
        <video
          class="card-video"
          src={p.video}
          poster={p.poster}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        />
      ) : p.cover ? (
        <Image src={p.cover} alt="" widths={[480, 800]} sizes="(max-width: 700px) 100vw, 400px" />
      ) : (
        <span class="placeholder" aria-hidden="true">
          <span class="browser">
            <i></i><i></i><i></i>
          </span>
          <span class="name">{p.client}</span>
        </span>
      )
    }
  </a>
  <div class="meta">
    <span class="pill">{p.category}</span>
    <span class="industry">{p.industry}</span>
  </div>
  <h3><a href={`/work/${project.id}/`}>{p.title}</a></h3>
  <p>{p.summary}</p>
</article>

<script>
  // Play card videos only while they are on screen, to save data and battery.
  const videos = document.querySelectorAll<HTMLVideoElement>('.card-video');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.4 }
    );
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  .card-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .card {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .cover {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--tint);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .cover:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -20px rgba(29, 27, 75, 0.35);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .placeholder {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 24px;
    text-align: center;
  }
  .browser {
    position: absolute;
    top: 16px;
    left: 18px;
    display: flex;
    gap: 6px;
  }
  .browser i {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(29, 27, 75, 0.2);
  }
  .name {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #1d1b4b;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .industry {
    font-size: 14px;
    color: var(--muted);
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent-ink);
  }
  p {
    color: var(--muted);
    font-size: 16px;
  }
</style>
