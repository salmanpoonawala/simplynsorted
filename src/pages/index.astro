---
import { url } from '../utils/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTA from '../components/CTA.astro';
import { serviceGroups } from '../data/services';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? a.data.order) - (b.data.featuredOrder ?? b.data.order))
  .slice(0, 3);
const clients = projects.filter((p) => p.data.homeTicker).map((p) => p.data.client);

const steps = [
  { n: '01', title: 'Understand', text: 'We learn your business, your customers and what is getting in the way.' },
  { n: '02', title: 'Build', text: 'We design and build the website, store or system you actually need.' },
  { n: '03', title: 'Grow', text: 'We run the marketing that brings the right people to it.' },
  { n: '04', title: 'Improve', text: 'We measure what works, report clearly and keep making it better.' },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-inner" data-hero>
        <p class="eyebrow">Websites · Software &amp; CRM · Performance marketing</p>
        <h1>We build it.<br />We grow it.<br />You are <span class="accent">sorted.</span></h1>
        <p class="lead">
          One team for your website, your software and your marketing, so nothing falls through the cracks between
          agencies.
        </p>
        <div class="hero-actions">
          <a href={url("/work/")} class="btn btn--primary" data-magnetic>See our work</a>
          <a href={url("/contact/")} class="btn btn--ghost" data-magnetic>Book a call</a>
        </div>
      </div>
      <!-- Scattered tiles that snap into a sorted grid (drawn by src/scripts/hero-tiles.ts) -->
      <div class="hero-visual" aria-hidden="true">
        <canvas id="hero-tiles"></canvas>
      </div>
    </div>
  </section>

  <script>
    import { heroTiles } from '../scripts/hero-tiles';
    const c = document.getElementById('hero-tiles');
    if (c instanceof HTMLCanvasElement) heroTiles(c);
  </script>

  <!-- Client strip -->
  <section aria-label="Some of our clients" class="clients">
    <div class="ticker-label"><span>Trusted by</span></div>
    <div class="ticker">
      <div class="ticker-track">
        <ul>
          {clients.map((c) => <li>{c}</li>)}
        </ul>
        <!-- Extra copies make the loop seamless on wide screens; hidden from screen readers -->
        {
          [1, 2, 3].map(() => (
            <ul aria-hidden="true">
              {clients.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Real projects for real businesses.</h2>
        </div>
        <a href={url("/work/")} class="link-arrow">View all work <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid-3" data-stagger>
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Build + Grow -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">What we do</p>
          <h2>Most agencies build <em>or</em> market. We do both.</h2>
          <p class="lead">
            When the people who built your website also run your ads, everything connects: tracking works, landing pages
            convert, and you have one team to call.
          </p>
        </div>
      </div>
      <div class="split">
        {
          serviceGroups.map((g) => (
            <div class="group">
              <span class="tag">{g.label}</span>
              <h3>{g.title}</h3>
              <ul>
                {g.items.map((s) => (
                  <li>
                    <strong>{s.name}</strong>
                    <span>{s.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="more"><a href={url("/services/")} class="link-arrow">Explore services <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">How we work</p>
          <h2>Simple process. Sorted results.</h2>
        </div>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <span class="num">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .hero {
    padding-block: clamp(72px, 12vw, 150px) clamp(48px, 8vw, 96px);
  }
  .hero {
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .hero-inner {
    display: grid;
    gap: 24px;
  }
  .hero h1 {
    max-width: 960px;
  }
  .hero-visual {
    height: clamp(240px, 62vw, 340px);
  }
  .hero-visual canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 56px;
    }
    .hero-visual {
      height: auto;
      aspect-ratio: 7 / 8;
      max-height: 560px;
    }
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  /* "Trusted by" news-style ticker */
  .clients {
    display: flex;
    align-items: stretch;
    border-block: 1px solid var(--line);
    overflow: hidden;
  }
  .ticker-label {
    flex: none;
    display: flex;
    align-items: center;
    padding: 0 24px 0 var(--pad);
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }
  .ticker {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding-block: 26px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 28s linear infinite;
  }
  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }
  .ticker ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex: none;
  }
  .ticker li {
    display: flex;
    align-items: center;
    gap: 48px;
    padding-right: 48px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  .ticker li::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
  }
  @keyframes ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 600px) {
    .ticker-label {
      padding: 0 14px;
      font-size: 11px;
    }
    .ticker li {
      font-size: 17px;
      gap: 32px;
      padding-right: 32px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
    .ticker {
      overflow-x: auto;
    }
  }

  .section-head em {
    font-style: normal;
    color: var(--accent-strong);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 28px;
  }
  .group {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(28px, 4vw, 40px);
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .tag {
    justify-self: start;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .group li {
    display: grid;
    gap: 4px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }
  .group li span {
    color: var(--muted);
    font-size: 16px;
  }
  .more {
    margin-top: 32px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 28px;
  }
  .steps li {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }
  /* Coral line drawn over the top border as you scroll (--draw goes 0 → 1) */
  .steps li::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(var(--draw, 0));
    transform-origin: 0 50%;
  }
  .num {
    display: inline-block;
    justify-self: start;
    font-weight: 800;
    color: var(--accent-strong);
  }
  .steps p {
    color: var(--muted);
    font-size: 16px;
  }
</style>
