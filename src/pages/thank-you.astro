---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
---

<Base title="Thank you" description="Thanks for getting in touch.">
  <section class="section">
    <div class="container box">
      <p class="eyebrow">Message sent</p>
      <h1>Thanks! Consider it <span class="accent">sorted.</span></h1>
      <p class="lead">We've got your message and will reply within one working day.</p>
      <div><a href={url("/work/")} class="btn btn--ghost">Browse our work meanwhile</a></div>
    </div>
  </section>
</Base>

<style>
  .box {
    display: grid;
    gap: 20px;
    min-height: 50vh;
    align-content: center;
  }
</style>
