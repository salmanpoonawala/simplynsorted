---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTA from '../../components/CTA.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);

const others = (await getCollection('projects'))
  .filter((x) => x.id !== project.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const host = p.url ? new URL(p.url).hostname.replace(/^www\./, '') : null;
---

<Base title={`${p.client} — ${p.title}`} description={p.summary}>
  <article>
    <header class="section head">
      <div class="container head-inner">
        <a href="/work/" class="back link-arrow"><span aria-hidden="true">←</span> All work</a>
        <p class="eyebrow">{p.client} · {p.industry}</p>
        <h1>{p.title}</h1>
        <p class="lead">{p.summary}</p>
        <dl class="facts">
          <div><dt>Client</dt><dd>{p.client}</dd></div>
          <div><dt>Type</dt><dd>{p.category}</dd></div>
          {p.services.length > 0 && <div><dt>What we did</dt><dd>{p.services.join(', ')}</dd></div>}
          {p.year && <div><dt>Year</dt><dd>{p.year}</dd></div>}
          {
            p.url && (
              <div>
                <dt>Live site</dt>
                <dd><a href={p.url} target="_blank" rel="noopener">{host} <span aria-hidden="true">↗</span></a></dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <div class="container">
      <div class="cover" style={`--tint:${p.tint}`}>
        {
          p.video ? (
            <video
              class="hero-video"
              src={p.video}
              poster={p.poster}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={`Scrolling through the ${p.client} website`}
            />
          ) : p.cover ? (
            <Image src={p.cover} alt={`${p.client} website`} widths={[800, 1200, 1800]} sizes="(max-width: 1240px) 100vw, 1200px" />
          ) : (
            <span class="placeholder">{p.client}</span>
          )
        }
      </div>
    </div>

    {
      p.results.length > 0 && (
        <section class="container results" aria-label="Results">
          {p.results.map((r) => (
            <div>
              <strong>{r.value}</strong>
              <span>{r.label}</span>
            </div>
          ))}
        </section>
      )
    }

    <section class="section">
      <div class="container prose">
        <Content />
      </div>
    </section>

    {
      p.testimonial && (
        <section class="container">
          <figure class="quote">
            <blockquote>“{p.testimonial.quote}”</blockquote>
            <figcaption>
              <strong>{p.testimonial.name}</strong>
              {p.testimonial.role && <span>{p.testimonial.role}</span>}
            </figcaption>
          </figure>
        </section>
      )
    }
  </article>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">More work</p><h2>Keep exploring.</h2></div>
        <a href="/work/" class="link-arrow">All projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid-3">{others.map((o) => <ProjectCard project={o} />)}</div>
    </div>
  </section>

  <CTA title="Want results like these?" />
</Base>

<style>
  .head {
    padding-bottom: 48px;
  }
  .head-inner {
    display: grid;
    gap: 20px;
  }
  .head h1 {
    font-size: clamp(36px, 5vw, 60px);
    max-width: 900px;
  }
  .back {
    color: var(--muted);
    font-size: 15px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 16px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .facts dd {
    margin: 4px 0 0;
    font-weight: 600;
  }
  .facts a:hover {
    color: var(--accent-ink);
  }
  .cover {
    border-radius: 28px;
    overflow: hidden;
    background: var(--tint);
    border: 1px solid var(--line);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .placeholder {
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #1d1b4b;
    padding: 24px;
    text-align: center;
  }
  .results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .results div {
    display: grid;
    gap: 6px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .results strong {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--accent-strong);
    line-height: 1;
  }
  .results span {
    color: var(--muted);
  }
  .quote {
    margin: 0 0 96px;
    padding: clamp(32px, 5vw, 56px);
    border-radius: 28px;
    background: var(--surface);
    display: grid;
    gap: 24px;
  }
  blockquote {
    margin: 0;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  figcaption {
    display: grid;
    gap: 2px;
  }
  figcaption span {
    color: var(--muted);
  }
</style>
